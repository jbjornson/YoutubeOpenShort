{
  "manifest_version": 3,
  "name": "Shorts & Reels as Video",
  "description": "Open YouTube Shorts, Facebook Reels, and Instagram Reels as regular videos in a new tab, and control playback speed on YouTube (Shorts and watch pages), Facebook video, Instagram video, and TikTok.",
  "version": "0.10.0",
  "author": "Ru",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*"
  ],
  "content_scripts": [
    {
      "js": [
        "sites.config.js",
        "site-matcher.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.tiktok.com/*"
      ],
      "run_at": "document_idle"
    }
  ]
}
