{
  "manifest_version": 3,
  "name": "Youtube Shorts as Video",
  "description": "Open Youtube Shorts as a normal youtube video in a new tab. Replaces the short link with the watch&v=[video] link.",
  "version": "0.5.0",
  "author": "Ru",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "js": ["content.js"],
      "css": ["content.css"],
      "matches": [
        "*://*.youtube.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "yos@ottr.space",
      "strict_min_version": "109.0"
    }
  }
}
